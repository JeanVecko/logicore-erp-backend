# ── Application ───────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# ── Database ──────────────────────────────────────────────────────────────
# Dev (SQLite) :
DATABASE_URL="file:./dev.db"
# Prod (PostgreSQL) — décommenter et adapter, puis passer provider="postgresql"
# dans prisma/schema.prisma avant `prisma migrate deploy` :
# DATABASE_URL="postgresql://user:password@host:5432/logicore_erp?schema=public"

# ── JWT ───────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# ── Tokens (reset mot de passe / vérification email) ─────────────────────
PASSWORD_RESET_EXPIRES_IN_MINUTES=30
EMAIL_VERIFICATION_EXPIRES_IN_HOURS=24

# ── Sécurité ──────────────────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ── Seed (Super Admin par défaut) ─────────────────────────────────────────
SEED_COMPANY_NAME=LogiCore SA
SEED_SUPER_ADMIN_EMAIL=superadmin@logicore.local
SEED_SUPER_ADMIN_PASSWORD=ChangeMe123!
