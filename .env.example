# ── Application ───────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# ── Database (PostgreSQL) ─────────────────────────────────────────────────
# Adapter user/password/port à votre installation PostgreSQL locale.
# Créez d'abord la base : CREATE DATABASE snadarpe_erp;
DATABASE_URL="postgresql://postgres:VOTRE_MOT_DE_PASSE@localhost:5432/snadarpe_erp?schema=public"

# ── JWT ───────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# ── Tokens (reset mot de passe / vérification email) ─────────────────────
PASSWORD_RESET_EXPIRES_IN_MINUTES=30
EMAIL_VERIFICATION_EXPIRES_IN_HOURS=24
LOGIN_CODE_EXPIRES_IN_MINUTES=10

# ── Sécurité ──────────────────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ── Seed (Super Admin par défaut) ─────────────────────────────────────────
SEED_COMPANY_NAME=SNADARPE SA
SEED_SUPER_ADMIN_EMAIL=superadmin@snadarpe.local
SEED_SUPER_ADMIN_PASSWORD=ChangeMe123!
